SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-anon-key
SUPABASE_SERVICE_KEY=tu-service-role-key
SUPABASE_BUCKET=pawalert-fotos
SUPABASE_SENSITIVE_BUCKET=pawalert-evidencias-privadas

FRONTEND_URL=https://tu-frontend-publico.example
# Lista separada por comas. Agrega aquí los dominios Preview que deban llamar a la API.
CORS_ORIGINS=https://tu-frontend-publico.example
CRON_SECRET=cambia-este-secreto

# SMS existente
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Avisos de WhatsApp (apagados por defecto)
WHATSAPP_NOTIFICATIONS_ENABLED=false
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_BASE_URL=https://tu-backend-publico.example
TWILIO_VALIDATE_SIGNATURES=true

# WhatsApp Cloud API (Meta) — reportes conversacionales
# El verify token lo eliges tú y lo pegas también al registrar el webhook en Meta.
WHATSAPP_META_VERIFY_TOKEN=
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v25.0

REQUIRE_PHONE_VERIFICATION=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FILE_TIMEOUT_SECONDS=180

OPENWEATHER_API_KEY=

# OSRM no requiere API key. Para producción puede apuntar a una instancia propia.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=8
OSRM_MAX_COORDINATES=100

# VROOM no tiene servidor público — apunta a la instancia propia desplegada en
# Railway (red privada). Vacío = deshabilitado (el cliente responde
# "not_configured" sin intentar ninguna llamada).
VROOM_BASE_URL=
VROOM_TIMEOUT_SECONDS=10
# Candidatos dentro de esta diferencia respecto al ETA minimo compiten por score.
VROOM_CANDIDATE_WINDOW_MINUTES=5
# Fuera de este ETA absoluto solo se permite recomendacion manual.
VROOM_SECONDARY_MAX_ETA_MINUTES=30
# Tamano maximo combinado (voluntarios + reportes) que se envia a VROOM en un
# solo lote antes de rechazar sin llamar al proveedor. Medido contra la
# instancia real de Railway: responde en segundos hasta ~400 locations, desde
# ~430 deja de responder (timeout duro). Se deja con margen de seguridad.
VROOM_MAX_LOCATIONS=50

# Similitud visual CLIP. Se habilita solo después de aplicar la migración
# pgvector y calibrar los umbrales con fotografías representativas.
CLIP_VALIDATION_ENABLED=false
HUGGINGFACE_TOKEN=
# URL del Inference Endpoint personalizado que devuelve {"embedding": [...]}.
CLIP_ENDPOINT_URL=
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_TIMEOUT_SECONDS=8
CLIP_GRAY_THRESHOLD=0.88
CLIP_HIGH_THRESHOLD=0.94

# Avistamientos: distancia máxima (metros) entre el GPS de quien registra y el
# punto de referencia del caso para que reportante / voluntario verificado
# puedan intentar registrar un avistamiento. Asociación y staff quedan exentos.
RADIO_ENTRADA_AVISTAMIENTO_METROS=500

# Auto-validación de avistamientos. Condición 2: trust score mínimo Y
# distancia máxima al punto de referencia del caso (ambas juntas).
# Condición 3: dos avistamientos del mismo animal dentro de AMBAS ventanas
# (distancia y tiempo) se corroboran y se validan juntos.
TRUST_SCORE_MINIMO_AUTO_VALIDACION=60
RADIO_COHERENCIA_AVISTAMIENTO_METROS=800
RADIO_CORROBORACION_AVISTAMIENTO_METROS=50
VENTANA_CORROBORACION_AVISTAMIENTO_MINUTOS=5
AVISTAMIENTO_UMBRAL_PROBABILIDAD_MISMO_ANIMAL=0.5

# Correos transaccionales del backend
BREVO_API_KEY=

# Firebase Admin: usa una de estas opciones. Nunca expongas estos valores en Expo.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
