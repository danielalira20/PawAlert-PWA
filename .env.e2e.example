# Usa exclusivamente una base de datos local o un proyecto Supabase de pruebas.
E2E_ALLOW_WRITES=false
E2E_API_URL=http://127.0.0.1:8000

# Cuenta autora para crear reportes de prueba.
E2E_AUTHOR_EMAIL=autor.e2e@example.test
E2E_AUTHOR_PASSWORD=Pawalert123!

# Tres cuentas distintas; un usuario solo puede denunciar una vez el mismo caso.
E2E_REPORTER_1_EMAIL=denuncia1.e2e@example.test
E2E_REPORTER_1_PASSWORD=Pawalert123!
E2E_REPORTER_2_EMAIL=denuncia2.e2e@example.test
E2E_REPORTER_2_PASSWORD=Pawalert123!
E2E_REPORTER_3_EMAIL=denuncia3.e2e@example.test
E2E_REPORTER_3_PASSWORD=Pawalert123!

# Cuenta con rol admin en el ambiente de pruebas.
E2E_ADMIN_EMAIL=admin.e2e@example.test
E2E_ADMIN_PASSWORD=Pawalert123!
