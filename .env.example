# Configuración pública de Firebase Web. Copia estos valores desde la app web
# del proyecto en Firebase Console. No uses aquí la cuenta de servicio.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Supabase público para el cliente Expo (nunca usar service_role/secret aquí).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clave pública para las teselas raster de CARTO Basemaps.
EXPO_PUBLIC_CARTO_API_KEY=
